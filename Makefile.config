# -----------------------------------------------------------------------
#
#   Configuration Makefile for RH
#
#   Edit the variables below to reflect your compilers and environment.
#
# -----------------------------------------------------------------------

CC       = mpicc
CFLAGS   = -O2 -DHAVE_F90 -Wformat

F90C     = gfortran
F90FLAGS = -O2

LD       = mpicc
LDFLAGS  = -lm

AR       = ar
ARFLAGS  = rs
RANLIB   = ranlib

ifneq ("$(wildcard /usr/include/tirpc)","")
    CFLAGS += -I/usr/include/tirpc
    LDFLAGS += -ltirpc
endif

HDF5_DIR = /Users/tiago/mambaforge/envs/py313/

# The OS variable should have the operative system name
# If the command below is unavailable, please edit manually
OS = $(shell uname -s)
